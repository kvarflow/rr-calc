#!/usr/bin/env node
'use strict';

// TODO: use bundled output in official UI, switch Typescript version to generate modern JS

const Bundler = require('../bundler');
const bundler = new Bundler(__dirname);

// Modules are listed in dependency order: each one's top-level code may only use modules
// listed before it. See Bundler#concat for how they are stitched together.

// calc/data
let bundled = `(() => {
'use strict';
const exports = {};
`;
bundled += bundler.concat([
  'util.js',
  'data/species.js',
  'data/types.js',
  'data/natures.js',
  'data/abilities.js',
  'data/moves.js',
  'data/items.js',
  'data/index.js',
]);
bundled += `
// EXPORTS
window.calc = Object.assign(window.calc || {}, {
  Generations: exports.Generations,
  ABILITIES: exports.ABILITIES,
  ITEMS: exports.ITEMS,
  MEGA_STONES: exports.MEGA_STONES,
  MOVES: exports.MOVES,
  SPECIES: exports.SPECIES,
  NATURES: exports.NATURES,
  TYPE_CHART: exports.TYPE_CHART,
});
})();`
bundler.bundle(bundled, 'data/production.min.js');

// calc
bundled = `(() => {
  'use strict';
  const exports = {};
  `;
bundled += bundler.concat([
  'util.js',
  'stats.js',
  'pokemon.js',
  'field.js',
  'move.js',
  'items.js',
  'mechanics/util.js',
  'result.js',
  'desc.js',
  'mechanics/gen789.js',
  'mechanics/gen56.js',
  'mechanics/gen4.js',
  'mechanics/gen3.js',
  'mechanics/gen12.js',
  'calc.js',
]);

bundled += `
// EXPORTS
window.calc = Object.assign(window.calc || {}, {
  Field: exports.Field,
  Side: exports.Side,
  Pokemon: exports.Pokemon,
  Move: exports.Move,
  calculate: exports.calculate,
  Result: exports.Result,
  toID: exports.toID,
  STATS: exports.STATS,
  Stats: exports.Stats,
});
})();`
bundler.bundle(bundled);
