#!/bin/bash -e
#
# Builds the calculator and publishes it to this fork's gh-pages branch, which GitHub
# Pages serves (repo Settings > Pages > Deploy from a branch > gh-pages, / (root)).
#
# The gh-pages branch only ever holds the latest build: each run replaces it with a
# single fresh commit. The original calculator's Google Analytics tag is removed so
# visits to this copy are not reported to it.

rev=$(git rev-parse --short HEAD)
remote=$(git remote get-url origin)
site=$(mktemp -d)
trap 'rm -rf "$site"' EXIT

node build

cp -r dist/. "$site"
cd "$site"
# Build inputs and test/type files are not needed on the site.
rm -rf calc/test oms.html
find . \( -name '*.template.html' -o -name '*.map' -o -name '*.d.ts' \) -delete
sed -i '/googletagmanager\.com\/gtag/d' ./*.html
# Serve files as-is instead of running them through Jekyll.
touch .nojekyll

git init -q -b gh-pages
git add -A
git commit -q -m "Publish ${rev}"
git push -q --force "$remote" gh-pages

echo "Published ${rev} to gh-pages"
