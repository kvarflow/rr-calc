#!/usr/bin/env node
'use strict';

const path = require('path');
const fs = require('fs');
const crypto = require('crypto');
const vm = require('vm');

const rootDir = '.';

// update version
function makeCachebuster(template, output) {
	let indexContents = fs.readFileSync(path.resolve(rootDir, template), {encoding: 'utf8'});

	// add hashes to js and css files
	process.stdout.write("Updating hashes... ");
	indexContents = indexContents.replace(/(src|href)="\.\/(.*?)\?[a-z0-9]*?"/g, function (a, b, c) {
		let hash = Math.random(); // just in case creating the hash fails
		try {
			const filename = c.replace('//play.pokemonshowdown.com/', '../../play.pokemonshowdown.com/');
			const fstr = fs.readFileSync(path.resolve(rootDir, 'dist', filename), 'utf8');
			hash = crypto.createHash('md5').update(fstr).digest('hex').substr(0, 8);
		} catch (e) {}

		return b + '="./' + c + '?' + hash + '"';
	}).replace(/\.template\.html/g, '.html');
	process.stdout.write("Writing new `" + output + "` file... ");
	fs.writeFileSync(path.resolve(rootDir, output), indexContents);
	console.log("DONE");
}

// Offline mode (src/sw.js): list every page, each local file it loads and the images their
// stylesheets use, for the service worker to save, with a version that changes whenever any
// of them does, so browsers install the new set and delete the old one.
function makeServiceWorker(pages) {
	const files = new Set(['./']);
	let contents = '';
	for (const page of pages) {
		const html = fs.readFileSync(path.resolve(rootDir, 'dist', page), 'utf8');
		files.add('./' + page);
		contents += html;
		html.replace(/(?:src|href)="(\.\/[^"]+)"/g, function (match, url) {
			files.add(url);
		});
	}
	for (const file of Array.from(files)) {
		const cssPath = file.split('?')[0];
		if (!cssPath.endsWith('.css')) continue;
		const css = fs.readFileSync(path.resolve(rootDir, 'dist', cssPath), 'utf8');
		css.replace(/url\(['"]?([^'")]+)['"]?\)/g, function (match, url) {
			if (/^(data:|https?:|\/\/)/.test(url)) return;
			files.add('./' + path.posix.normalize(path.posix.join(path.posix.dirname(cssPath.slice(2)), url)));
		});
	}
	// The app icons the manifest names (the pages only link the small ones).
	const manifestPath = path.resolve(rootDir, 'dist', 'manifest.webmanifest');
	if (fs.existsSync(manifestPath)) {
		for (const icon of JSON.parse(fs.readFileSync(manifestPath, 'utf8')).icons || []) files.add('./' + icon.src);
	}
	const list = Array.from(files);
	const version = crypto.createHash('md5').update(list.join('\n') + contents).digest('hex').substr(0, 8);
	const swPath = path.resolve(rootDir, 'dist', 'sw.js');
	const sw = fs.readFileSync(swPath, 'utf8')
		.replace('"__VERSION__"', JSON.stringify(version))
		.replace('__PRECACHE__', JSON.stringify(list, null, '\t'));
	fs.writeFileSync(swPath, sw);
	console.log('Service worker ' + version + ': ' + list.length + ' files for offline use');
}

function cpdir(src, dest) {
	console.log("Copying `" + src + "` to `" + dest + "`");
	try {
		fs.mkdirSync(dest, '0755');
	} catch(e) {
		if (e.code != 'EEXIST') throw e;
	}
	for (const file of fs.readdirSync(src)) {
		var current = fs.lstatSync(path.join(src, file));
		if (current.isDirectory()) {
			cpdir(path.join(src, file), path.join(dest, file));
		} else if (current.isSymbolicLink()) {
			var symlink = fs.readlinkSync(path.join(src, file));
			fs.symlinkSync(symlink, path.join(dest, file));
		} else if (file.endsWith('.js')) {
			let contents = fs.readFileSync(path.join(src, file), 'utf8').replace(/^exports.* = void 0;$/gm, '');
			// Minify the sets so we save bandwith
			if (src === 'src/js/data/sets') {
				const brkOpenIdx = contents.indexOf('{');
				contents = `${contents.slice(0, brkOpenIdx)}${JSON.stringify(JSON.parse(contents.slice(brkOpenIdx, -2)))};`
			}
			fs.writeFileSync(path.join(dest, file), contents);
		} else {
			fs.copyFileSync(path.join(src, file),path.join(dest, file));
		}
	}
}

/*
 * Every game's pages (src/js/games.js) from the one page template (src/game.template.html): each
 * mode's page with its title, generation, mode buttons, sets, game data and trainers. `--test-games`
 * also writes pages for vanilla Gen 3 and Gen 4 test games (no data of their own), for the tests;
 * they are never published.
 */
const TEST_GAMES = [
	{id: 'test-gen3', name: 'Test Gen 3', title: 'Test Gen 3 Calculator', gen: 3, status: 'ready',
		modes: [{id: 'test-gen3', label: 'Test Gen 3', page: 'test-gen3'}], features: {}},
	{id: 'test-gen4', name: 'Test Gen 4', title: 'Test Gen 4 Calculator', gen: 4, status: 'ready',
		modes: [{id: 'test-gen4', label: 'Test Gen 4', page: 'test-gen4'}], features: {}},
];

function loadGames() {
	// games.js also sets up the game picker when the page is ready: nothing to do here.
	const context = {$: () => ({ready() {}}), document: {}};
	vm.createContext(context);
	vm.runInContext(fs.readFileSync(path.resolve(rootDir, 'src/js/games.js'), 'utf8') + ';this.GAMES = GAMES;', context);
	return context.GAMES;
}

const htmlText = text => text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const script = src => '    <script type="text/javascript" src="./' + src + '?"></script>\n';

function renderGamePage(template, game, mode, testGame) {
	const radios = (game.oneVsOne ? [{id: 'one-vs-one', label: 'One vs One'}] : []).concat(game.modes);
	const modeRadios = radios.map((m, i) => {
		const position = radios.length === 1 ? 'btn-left btn-right' : i === 0 ? 'btn-left' : i === radios.length - 1 ? 'btn-right' : 'btn-mid';
		return '            <input class="mode visually-hidden" type="radio" name="mode" id="' + m.id + '"' +
			(m.id === mode.id ? ' checked="checked"' : '') + ' /><label class="btn ' + position + '" for="' + m.id + '">' +
			htmlText(m.label) + '</label>\n';
	}).join('');
	// The mode's own sets, then Showdown's for the other generations (its own generation's only when
	// the mode has none).
	let sets = mode.sets ? script('js/data/sets/' + mode.sets + '.js') : '';
	for (let gen = 9; gen >= 1; gen--) {
		if (gen === game.gen && mode.sets) continue;
		sets += script('js/data/sets/gen' + gen + '.js');
	}
	const gameData = (testGame ? '    <script type="text/javascript">GAMES.push(' + JSON.stringify(game) + ');</script>\n' : '') +
		(game.data ? script('js/data/games/' + game.data + '.js') : '');
	const links = game.links || {};
	const fill = {
		GAME_ID: game.id,
		TITLE: htmlText(game.title || game.name + ' Damage Calculator'),
		GEN: String(game.gen),
		MODE_RADIOS: modeRadios,
		SETS_SCRIPTS: sets,
		GAME_DATA_SCRIPTS: gameData,
		// A game with no boss fights yet: no trainers, and no trainer panel.
		TRAINERS_SCRIPTS: mode.trainers ? script('js/data/trainers/' + mode.trainers + '.js') :
			'    <script type="text/javascript">var TRAINER_ORDER = [];</script>\n',
		DEX_LINK: links.dex ? '        <li><a class="button" href="' + links.dex + '">Pok&eacute;dex</a></li>\n' : '',
		PLAY_LINK: links.play ? '    <ul class="nav nav-play">\n        <li><a class="button greenbutton nav-first nav-last" href="' +
			links.play + '">Play</a></li>\n    </ul>\n' : '',
	};
	return template.replace(/\{\{([A-Z_]+)\}\}/g, (match, key) => {
		if (!(key in fill)) throw new Error('game.template.html: no value for {{' + key + '}}');
		return fill[key];
	});
}

function makeGamePages(withTestGames) {
	const template = fs.readFileSync(path.resolve(rootDir, 'dist/game.template.html'), 'utf8');
	const pages = [];
	const games = loadGames().filter(game => game.status === 'ready').map(game => ({game, test: false}))
		.concat(TEST_GAMES.map(game => ({game, test: true})));
	for (const {game, test} of games) {
		for (const mode of game.modes) {
			const output = 'dist/' + mode.page + '.html';
			if (test && !withTestGames) {
				// A test page from an earlier build is not left to be published.
				for (const file of [output, 'dist/' + mode.page + '.template.html']) {
					if (fs.existsSync(path.resolve(rootDir, file))) fs.unlinkSync(path.resolve(rootDir, file));
				}
				continue;
			}
			fs.writeFileSync(path.resolve(rootDir, 'dist/' + mode.page + '.template.html'), renderGamePage(template, game, mode, test));
			makeCachebuster('dist/' + mode.page + '.template.html', output);
			if (!test) pages.push(mode.page + '.html');
		}
	}
	return pages;
}

if (process.argv[2] !== 'view') {
	require('child_process').execSync('npm --prefix calc/ run compile', {stdio: 'inherit'});
}

cpdir('src', 'dist');
cpdir('calc/dist', 'dist/calc');
makeCachebuster('dist/honkalculate.template.html', 'dist/honkalculate.html');
makeCachebuster('dist/index.template.html', 'dist/index.html');
const gamePages = makeGamePages(process.argv.includes('--test-games'));
makeServiceWorker(['index.html'].concat(gamePages));
